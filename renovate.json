{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>Heey-Global/.github"
  ],
  "semanticCommits": "enabled",
  "packageRules": [
    {
      "matchUpdateTypes": ["patch"],
      "semanticCommitType": "fix"
    },
    {
      "matchUpdateTypes": ["minor"],
      "semanticCommitType": "fix"
    },
    {
      "matchUpdateTypes": ["major"],
      "semanticCommitType": "feat"
    },
    {
      "matchDepTypes": ["devDependencies"],
      "matchPackageNames": ["typescript", "ts-jest", "@types/node", "@types/jest"],
      "groupName": "TypeScript toolchain",
      "automerge": true
    },
    {
      "description": "typescript-eslint 8.x supports TypeScript <6.1.0 only; raise together with typescript-eslint",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1.0"
    },
    {
      "description": "ajv overrides in pnpm-workspace.yaml are pinned per major line (eslint needs ajv 6); never bump them across majors",
      "matchDepNames": ["/^ajv@/"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchDepTypes": ["devDependencies"],
      "matchPackageNames": [
        "eslint",
        "eslint-config-prettier",
        "eslint-plugin-n8n-nodes-base",
        "@typescript-eslint/eslint-plugin",
        "@typescript-eslint/parser"
      ],
      "groupName": "ESLint",
      "automerge": true
    },
    {
      "matchDepTypes": ["devDependencies"],
      "matchPackageNames": ["jest", "jest-mock-extended", "ts-jest"],
      "groupName": "Jest",
      "automerge": true
    },
    {
      "matchPackageNames": ["n8n-workflow", "n8n-core"],
      "groupName": "n8n",
      "automerge": false
    }
  ]
}
